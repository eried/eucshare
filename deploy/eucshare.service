[Unit]
Description=eucshare (EUC Planet location-share relay)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/eucshare
Environment="PATH=/opt/eucshare/.venv/bin"
Environment="EUCSHARE_ROOM_TTL_S=120"
ExecStart=/opt/eucshare/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8006 --proxy-headers --no-access-log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
